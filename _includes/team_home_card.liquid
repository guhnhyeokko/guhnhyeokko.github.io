{%- comment -%}
  Compact member card for the home-page team preview.
  Parameters:
    member - a _members document
    badge  - optional label rendered as a pill (e.g. the role or research area)
{%- endcomment -%}
{%- assign m = include.member -%}
{%- if m.redirect -%}
  {%- assign member_link = m.redirect | relative_url -%}
{%- else -%}
  {%- assign member_link = m.url | relative_url -%}
{%- endif -%}
<div class="col pb-3">
  <div class="card member-card h-100 hoverable">
    <div class="card-body d-flex align-items-center">
      <a href="{{ member_link }}" class="flex-shrink-0">
        {%- if m.profile.image -%}
          {%- assign member_image_path = m.profile.image | prepend: 'assets/img/' | relative_url -%}
          <img src="{{ member_image_path }}" alt="{{ m.profile.name }}" class="rounded member-avatar--sm" loading="lazy">
        {%- else -%}
          <div class="member-no-photo member-no-photo--sm rounded" aria-label="No photo available">
            <i class="fa-solid fa-user"></i>
          </div>
        {%- endif -%}
      </a>
      <div class="flex-grow-1">
        <h6 class="card-title mb-1">
          <a href="{{ member_link }}">{{ m.profile.name }}</a>
        </h6>
        <p class="card-subtitle text-muted mb-0 member-card-position">{{ m.profile.position }}</p>
        {%- if include.badge -%}
          <span class="badge rounded-pill mt-1 member-badge">{{- include.badge -}}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
